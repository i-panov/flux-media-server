{
  "expo": {
    "name": "Flux",
    "slug": "mobile",
    "scheme": "flux",
    "version": "0.1.45",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.lib.flux",
      "buildNumber": "63",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Flux обращается к вашему домашнему медиа-серверу в локальной сети."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#181428",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.lib.flux",
      "versionCode": 63,
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#ffffff",
          "resizeMode": "contain",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#141517"
          }
        }
      ],
      [
        "expo-video",
        {
          "supportsPictureInPicture": true
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true,
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "microphonePermission": false,
          "photosPermission": "Flux открывает выбранное фото для обложки.",
          "cameraPermission": false
        }
      ],
      "expo-image",
      "expo-system-ui",
      [
        "@react-native-tvos/config-tv",
        {
          "isTV": false,
          "removeFlipperOnAndroid": true,
          "androidTVBanner": "./assets/tv-banner.png",
          "androidTVIcon": "./assets/tv-icon.png"
        }
      ],
      "./plugins/withCleartextTraffic",
      "./plugins/withReleaseSigning"
    ]
  }
}
