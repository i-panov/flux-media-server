{
	"name": "flux-web",
	"private": true,
	"version": "0.1.30",
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"size-limit": [
		{
			"path": "dist/assets/index-*.js",
			"limit": "700 kB"
		},
		{
			"path": "dist/assets/index-*.css",
			"limit": "350 kB"
		}
	],
	"scripts": {
		"dev": "vite",
		"build": "tsr generate && tsc --noEmit && vite build",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"test:e2e:proxy": "playwright test -c playwright.proxy.config.ts",
		"test:coverage": "vitest run --coverage",
		"format": "biome format --write",
		"lint": "biome check && eslint .",
		"lint:fix": "biome check --write",
		"lint:eslint": "eslint .",
		"lint:deadcode": "knip",
		"size": "size-limit"
	},
	"dependencies": {
		"@flux/shared": "0.1.7",
		"@mantine/core": "^9.2.2",
		"@mantine/hooks": "^9.2.2",
		"@mantine/notifications": "^9.2.2",
		"@noriginmedia/norigin-spatial-navigation": "^3.4.0",
		"@tanstack/react-query": "^5.105.0",
		"@tanstack/react-router": "^1.170.46",
		"i18next": "^26.3.0",
		"i18next-browser-languagedetector": "^8.2.1",
		"lucide-react": "^1.62.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"react-i18next": "^17.0.8",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.3",
		"@eslint/js": "^9.39.5",
		"@playwright/test": "^1.64.1",
		"@size-limit/preset-app": "^14.3.0",
		"@tailwindcss/vite": "^4.1.18",
		"@tanstack/router-cli": "^1.167.46",
		"@tanstack/router-plugin": "^1.168.48",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.2",
		"@types/node": "^26.6.5",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^6.0.1",
		"@vitest/coverage-v8": "^5.0.5",
		"eslint": "^9.39.4",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-sonarjs": "^4.2.0",
		"globals": "^17.11.0",
		"jsdom": "^30.1.3",
		"knip": "^6.33.0",
		"postcss": "^8.5.15",
		"postcss-preset-mantine": "^1.18.0",
		"postcss-simple-vars": "^7.0.1",
		"size-limit": "^14.3.0",
		"tailwindcss": "^4.1.18",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.68.0",
		"vite": "^8.0.0",
		"vite-plugin-pwa": "^2.0.0",
		"vitest": "^5.0.5",
		"workbox-precaching": "^7.4.1"
	},
	"knip": {
		"entry": [
			"src/routes/**/*.tsx",
			"e2e/**/*.ts"
		]
	}
}
