{
	"$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**/src/**/*",
			"**/e2e/**/*",
			"**/vite.config.ts",
			"**/vitest.setup.ts",
			"**/postcss.config.mjs",
			"**/playwright.config.ts",
			"**/playwright.proxy.config.ts",
			"!!**/routeTree.gen.ts",
			"!!**/node_modules",
			"!!**/dist",
			"!!**/dev-dist",
			"!!**/coverage",
			"!!**/playwright-report",
			"!!**/test-results"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineEnding": "lf"
	},
	"assist": {
		"actions": { "source": { "organizeImports": "on" } }
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"complexity": {
				"useMaxParams": {
					"level": "error",
					"options": {
						"max": 7
					}
				},
				"noForEach": "error",
				"useOptionalChain": "error",
				"useLiteralKeys": "error",
				"noUselessTernary": "error",
				"noUselessUndefined": "error",
				"useDateNow": "error",
				"useFlatMap": "error"
			},
			"suspicious": {
				"noEmptyBlockStatements": "off",
				"noExplicitAny": "error",
				"noImplicitAnyLet": "error",
				"noEvolvingTypes": "error",
				"noConfusingVoidType": "error",
				"noConsole": {
					"level": "error",
					"options": {
						"allow": ["error", "warn"]
					}
				},
				"noCommentText": "error",
				"noArrayIndexKey": "error",
				"useAwait": "error",
				"noUnusedExpressions": "error"
			},
			"correctness": {
				"noUnresolvedImports": "off",
				"useExhaustiveDependencies": "error",
				"noUnusedFunctionParameters": "error",
				"useJsxKeyInIterable": "error",
				"noUndeclaredDependencies": "error"
			},
			"performance": {
				"useSolidForComponent": "off",
				"noAccumulatingSpread": "error",
				"useTopLevelRegex": "error"
			},
			"security": "error",
			"style": {
				"noJsxLiterals": "off",
				"noNonNullAssertion": "error",
				"noParameterAssign": "error",
				"useConst": "error",
				"useImportType": "error",
				"useExportType": "error",
				"useTemplate": "error",
				"noUselessElse": "error",
				"useThrowNewError": "error",
				"useThrowOnlyError": "error",
				"noSubstr": "error",
				"useShorthandAssign": "error",
				"noNegationElse": "error"
			},
			"a11y": "error"
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	}
}
